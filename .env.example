# Spark environment — copy this file to `.env` and fill in the keys you want.
#
# Everything here is OPTIONAL. Spark runs fine with an empty .env; each feature
# simply stays switched off until its key is present, and the app tells you so
# on startup. Never commit your real .env — it's gitignored for a reason.

# ---------------------------------------------------------------------------
# Real nearby places (Google Places + Claude)
# ---------------------------------------------------------------------------
# Turns real venues around you into Spark-style idea cards. Needs BOTH keys —
# Google to find the places, Claude to write the cards.
#
# Google Places key: https://console.cloud.google.com/ with the Places API
# enabled. Watch the billing on this one — Text Search is among their pricier
# SKUs and Spark issues several searches per session.
GOOGLE_PLACES_API_KEY=

# Anthropic key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Port the local server listens on. Defaults to 3000.
PORT=

# ---------------------------------------------------------------------------
# Database (optional) — server-side only. The browser never talks to Supabase.
# ---------------------------------------------------------------------------
# Supabase Postgres connection string (Project Settings → Database → Connection string → URI, "Session pooler", port 5432). Server-side only.
DATABASE_URL=
# Set to "disable" for a local Postgres without TLS (tests/CI). Leave empty for Supabase.
PGSSLMODE=
# Local/CI only: Postgres+PostGIS used by integration tests. Never point at production.
TEST_DATABASE_URL=
# Optional: directory of per-state coords JSON for the seed. Defaults to data/coords.
SPARK_COORDS_DIR=
# Optional: path to the ideas file for the seed. Defaults to public/data.js.
SPARK_IDEAS_FILE=

# Set to 1 only when Spark is behind a known reverse proxy (one hop).
# Rate limits then use the client address. Leave empty for local `npm start`.
TRUST_PROXY=
